DATABASE_URL=postgresql+psycopg://kurai:kurai-local@db:5432/kurai
POSTGRES_PASSWORD=kurai-local
# Set a long random value before enabling moderation. Empty disables admin actions.
ADMIN_TOKEN=
# Optional Telegram profile. Create the bot and set the token locally when ready.
# Do not paste the token into chat or commit this value to Git.
TELEGRAM_BOT_TOKEN=
LLM_ENABLED=false
COLLECTION_ENABLED=false
# Optional collection from the two configured official sources every six hours.
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_API_KEY=
# Free NVIDIA prototype endpoint only. No automatic paid provider or model fallback.
PORT=8000
